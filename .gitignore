__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments
venv/
env/
.venv/

# Ignore distribution and build files
dist/
build/
*.egg-info/
*.egg
*.whl

# Ignore pytest cache
.pytest_cache/

# Ignore IDE-specific files
.vscode/
.idea/
*.swp
*.swo

# Ignore local settings
local_settings.py
.env
.env.local

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

